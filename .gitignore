# Whitelist mode
**/*

# Settings (hooks, etc)
!settings.json
!statusline-command.sh

# Core instructions
!/CLAUDE.md
!/skill-dependency-isolation.md

# Hooks registry
!/hooks/
!/hooks/*.sh
hooks/test-hooks.sh


# Plugins registry — track manifests only; marketplace contents are managed by /plugin
!/plugins
!/plugins/known_marketplaces.json
!/plugins/installed_plugins.json


# Frictions (used by /learn)
!/friction/
!/friction/scripts/
!/friction/scripts/**
!/friction/domains/
!/friction/domains/**
!/friction/domain-map.json
# Exclude runtime data (ledger, logs, archives)
/friction/friction.jsonl
/friction/hook-activations.jsonl


# Memory store
!/memory/
!/memory/**


# Keep sub-directory gitignore files
!**/.gitignore


# Backlist files
**/.DS_Store
**/*.zip
